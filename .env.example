# ============================================
# RH Cursos Environment Configuration
# ============================================
# SECURITY: Never commit sensitive credentials to version control
#
# MODELO DE AMBIENTES (importante — leia antes de copiar):
#
#   Desenvolvimento local  -> runtime padrao do projeto: Node.js + Next.js + React.
#                             Copie este arquivo para `.env.local` e rode `npm run dev`.
#                             Aponte para um projeto Supabase de TESTE. NUNCA use
#                             credenciais de producao no dev local.
#
#   Produção               -> configure as variáveis no provedor de build do
#                             frontend e nos secrets do Supabase/GitHub Actions
#                             quando aplicável.
#
# Para validar o bundle de publicação localmente antes de subir: `npm run preview:static`

# ============================================
# Authentication & Security
# ============================================

# SESSION_SECRET for auth cookie signing (required in production)
# Must be at least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=your-32-char-secret-key-here-generate-a-secure-one
# REC-204 Fase A: e-mails de contas de teste, separados por virgula. Vazio desativa o rollout.
SSR_AUTH_ROLLOUT_ACCOUNTS=

# ============================================
# Demo Authentication Feature Flag
# ============================================
# SECURITY: Demo auth is DISABLED by default and only available in development
#
# Feature Flag: NEXT_PUBLIC_ENABLE_DEMO_AUTH
#   - true  = demo auth enabled (development only, never set in production)
#   - false = demo auth disabled (RECOMMENDED DEFAULT)
#
# To enable demo auth during local development:
#   1. Copy this file to .env.local
#   2. Set NEXT_PUBLIC_ENABLE_DEMO_AUTH=true
#   3. Optionally set DEMO_ADMIN_PASSWORD to override default (admin123)
#   4. Run `npm run dev`
#   5. Login with: admin@rhcursos.demo / admin123 (or your custom password)
#
# WARNING: Never enable in production. This will trigger critical security warnings.

NEXT_PUBLIC_ENABLE_DEMO_AUTH=false

# Demo admin password (optional override, only used if NEXT_PUBLIC_ENABLE_DEMO_AUTH=true)
# Default: admin123 (development-only placeholder, NEVER use in production)
# DEMO_ADMIN_PASSWORD=your-custom-demo-password

# ============================================
# Supabase Configuration
# ============================================
# Get these from: Supabase Dashboard > Project Settings > API

# Public API URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon Key (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.key

# Edge Functions base URL (modelo híbrido). Opcional — por padrão é derivado de
# NEXT_PUBLIC_SUPABASE_URL como `${url}/functions/v1`. Defina apenas se usar
# domínio custom para as functions.
# NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1

# Service Role Key (SECRET - never expose in frontend)
# No modelo híbrido o runtime das Edge Functions injeta esta chave automaticamente;
# mantida aqui apenas para scripts/migrations locais.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.key

# Database URL (SECRET)
# Set this to the database connection string from your Supabase project settings.
SUPABASE_DB_URL=

# Direct database URL for migrations (if different from above)
SUPABASE_URL=https://your-project-ref.supabase.co

# ============================================
# Application Configuration
# ============================================

NODE_ENV=development

# Public app URL (used for CORS, redirects, etc)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Asaas Hosted Checkout — DP Zero
# ============================================
# Use apenas credenciais Sandbox no desenvolvimento. O checkout falha fechado
# quando qualquer variável obrigatória está ausente ou inválida.
ASAAS_API_KEY=replace-with-sandbox-api-key
ASAAS_WEBHOOK_TOKEN=replace-with-a-unique-random-token-at-least-32-chars
ASAAS_ENVIRONMENT=sandbox
ASAAS_CHECKOUT_EXPIRES_MINUTES=30
# Só altere para true após validar comercialmente no Sandbox que 12 parcelas
# mantêm o total de R$ 297 para o comprador.
ASAAS_12X_INTEREST_FREE_CONFIRMED=false

# ============================================
# CRM Email Interaction Timeline (server-only)
# ============================================
# Segredos aleatórios com no mínimo 32 caracteres. Configure como secrets no
# runtime; nunca use prefixo NEXT_PUBLIC_ e nunca inclua valores reais no git.
SES_EVENTS_WEBHOOK_SECRET=replace-with-a-unique-random-secret-at-least-32-chars
IMAP_EVENTS_WEBHOOK_SECRET=replace-with-a-different-random-secret-at-least-32-chars
EMAIL_UNSUBSCRIBE_SECRET=replace-with-a-third-random-secret-at-least-32-chars

# As credenciais da Locaweb e este mesmo IMAP_EVENTS_WEBHOOK_SECRET ficam em um
# segredo JSON do AWS Secrets Manager consumido pela Lambda. Veja
# infrastructure/email-imap-collector/README.md. Não replique a senha no app.

# ============================================
# Analytics (EP-1.3 — Google Analytics 4)
# ============================================
# Measurement ID da propriedade GA4 (formato G-XXXXXXXXXX). OPCIONAL.
# Sem este valor o GA4 fica inativo (no-op): nenhum script é injetado e
# trackEvent() não faz nada. Em produção, defina via secret do Cloudflare:
#   wrangler secret put NEXT_PUBLIC_GA_MEASUREMENT_ID   (ou no painel do Worker)
# O ID é público por natureza (vai no bundle do cliente).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Sentry Error Tracking & Query Monitoring (Epic 8)
# ============================================
# Comprehensive error tracking and performance monitoring with graceful degradation.
# Without the DSN, Sentry becomes a no-op: no events are sent, no network calls made,
# and the app runs normally.
#
# KEY FEATURES:
# • Client-side error tracking (React component errors, browser errors)
# • Server-side error tracking (Node.js runtime errors)
# • Performance monitoring (100% sampling in dev, 10% in prod)
# • Session replay (50% in dev, 10% in prod for errors)
# • Slow query detection (queries > 200ms logged to Sentry)
# • Breadcrumb tracking (user actions, console logs, etc.)
#
# RUNTIME CONFIGURATION:
#
#   NEXT_PUBLIC_SENTRY_DSN
#     Public DSN for error tracking. Sentry initialization is skipped if absent.
#     Example: https://examplePublicKey@o0.ingest.sentry.io/0
#     Get from: Sentry dashboard > Settings > Client Keys (DSN)
#
#   NEXT_PUBLIC_APP_ENV
#     Environment tag (development/staging/production).
#     Default: NODE_ENV if not set.
#
# BUILD/CI CONFIGURATION (optional, skipped if token is absent):
#
#   SENTRY_ORG
#     Organization slug from Sentry dashboard (for source map upload).
#     Example: my-org-slug
#
#   SENTRY_PROJECT
#     Project slug from Sentry dashboard (for source map upload).
#     Example: site-rh-cursos
#
#   SENTRY_AUTH_TOKEN
#     API token for source map upload to Sentry (SECRET, CI/CD only).
#     Generate at: Sentry > Settings > Developer Settings > Auth Tokens
#     Grant: "project:releases" and "org:read" scopes
#
# DEVELOPMENT SETUP:
#   1. Create a free Sentry project at https://sentry.io
#   2. Get the DSN from Settings > Client Keys (DSN)
#   3. Set NEXT_PUBLIC_SENTRY_DSN below
#   4. Run: npm run dev
#   5. Visit: http://localhost:3000
#   6. Trigger errors (e.g., throw new Error("test")) to verify integration
#   7. View dashboard: https://sentry.io/organizations/YOUR-ORG/issues/
#
# PRODUCTION DEPLOYMENT:
#   1. Configure NEXT_PUBLIC_SENTRY_DSN in production environment
#   2. (Optional) Configure SENTRY_* for source map upload in CI/CD
#   3. Monitor dashboard for error trends, performance, and slow queries
#
# QUERY MONITORING:
#   • Slow queries (>200ms) are automatically logged to Sentry
#   • Supabase operations (select/insert/update/delete) are tracked
#   • Sampling: 100% in dev, 10% in production
#   • Console logs in development show query performance with ⚡ (fast) or 🐌 (slow)
#
# EXAMPLE SENTRY PROJECT URL:
#   https://sentry.io/organizations/your-org/issues/
#
# NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@sentry.io/your-project-id
# NEXT_PUBLIC_APP_ENV=development
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=site-rh-cursos
# SENTRY_AUTH_TOKEN=your-api-token-for-ci-cd
