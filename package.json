{
  "name": "site-rh-cursos",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:verify": "sh -c 'set -a; . ./.env.example; set +a; NODE_ENV=production next build --experimental-build-mode=compile'",
    "docs:api:lint": "node scripts/lint-openapi.mjs",
    "docs:api:build": "node scripts/build-api-docs.mjs",
    "docs:api:check-drift": "node scripts/check-openapi-drift.mjs",
    "docs:stories:index": "node scripts/generate-story-index.mjs",
    "env:check:production": "node scripts/check-production-env.mjs",
    "test:db": "node scripts/test-db.mjs",
    "build:workers": "opennextjs-cloudflare build",
    "start": "next start",
    "preview": "next start",
    "preview:workers": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:workers": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "verify:workers": "node scripts/verify-workers-deploy.js",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run typecheck && node scripts/build-playwright-app.mjs && node scripts/run-playwright-test-build.mjs",
    "test:unit": "vitest run --no-file-parallelism --maxWorkers=1",
    "verify:imap-collector": "npm --prefix infrastructure/email-imap-collector run verify",
    "test:coverage": "vitest run --coverage",
    "e2e:configure-supabase": "node scripts/configure-e2e-supabase.mjs",
    "test:e2e:smoke": "node scripts/run-playwright.mjs --project=functional",
    "test:e2e:public": "node scripts/run-playwright.mjs tests/smoke-crawl.spec.ts --grep \"páginas públicas\" --project=functional",
    "test:visual": "node scripts/run-playwright.mjs ui-governance.spec.ts --project=functional",
    "test:visual:update": "node scripts/run-playwright.mjs ui-governance.spec.ts --project=functional --update-snapshots",
    "test:epic14:fidelity:capture": "node scripts/capture-epic14-fidelity.mjs",
    "fidelity:references": "node scripts/build-fidelity-references.mjs",
    "fidelity:specs": "node scripts/build-fidelity-specs.mjs",
    "test:epic14:fidelity": "node scripts/run-playwright.mjs epic5-search-motion.spec.ts epic14-mantine-removal.smoke.spec.ts --project=functional",
    "test:epic15:fidelity": "node scripts/run-playwright.mjs epic15-admin-dashboard-fidelity.spec.ts epic15-blog-pages.spec.ts --project=functional",
    "test:epic20:fidelity": "node scripts/run-playwright.mjs epic20-admin-evolution.spec.ts --project=functional",
    "test:a11y": "node scripts/run-playwright.mjs a11y.spec.ts --project=functional",
    "test:a11y:baseline": "node scripts/run-playwright-test-build.mjs a11y.spec.ts --project=functional",
    "test:lighthouse": "npm run build && node scripts/run-lighthouse.mjs",
    "test:harness:audit": "npm run test:coverage && npm run test:e2e:smoke",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "analyze": "ANALYZE=true npm run build",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "css:check": "node scripts/check-css-budget.mjs",
    "validate-design-system": "node scripts/validate-design-system.mjs",
    "build:time-check": "node scripts/check-build-time.mjs",
    "purge:gate": "node scripts/purge-gate.mjs",
    "epic8:verify": "npm run purge:gate && npm run lint && npm run typecheck && npm run test:coverage && npm run storybook:build",
    "test:watch": "vitest",
    "devops:all": "node scripts/devops-run-all.mjs",
    "pos-push": "node scripts/devops-post-push.mjs",
    "seed:admin": "node --env-file=.env.local scripts/seed-admin.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@next/bundle-analyzer": "^16.2.9",
    "@next/third-parties": "^16.2.9",
    "@opennextjs/cloudflare": "^1.20.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.62.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.11",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.511.0",
    "next": "^16.2.2",
    "patch-package": "^8.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/nextjs-vite": "10.5.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.3",
    "secretlint": "^13.0.4",
    "storybook": "^10.4.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.99.0"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "uuid": "^14.0.1",
    "js-yaml": "^5.2.1",
    "postcss": "$postcss",
    "chrome-launcher": "1.2.1",
    "minimatch": "10.2.5",
    "browserslist": "^4.28.8",
    "@node-minify/core": "10.5.0",
    "@node-minify/terser": "10.5.0",
    "image-size": "file:vendor/image-size",
    "lighthouse": "13.4.1",
    "puppeteer-core": "25.8.0",
    "@puppeteer/browsers": "3.2.1",
    "next": {
      "sharp": "0.35.2"
    }
  }
}
