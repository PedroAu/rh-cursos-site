{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageRhCursosTransactionalSesConfigurationSet",
      "Effect": "Allow",
      "Action": [
        "ses:CreateConfigurationSet",
        "ses:DeleteConfigurationSet",
        "ses:GetConfigurationSet",
        "ses:CreateConfigurationSetEventDestination",
        "ses:DeleteConfigurationSetEventDestination",
        "ses:GetConfigurationSetEventDestinations",
        "ses:UpdateConfigurationSetEventDestination",
        "ses:TagResource",
        "ses:UntagResource"
      ],
      "Resource": "arn:aws:ses:sa-east-1:620444453976:configuration-set/rh-cursos-transactional"
    },
    {
      "Sid": "ReadSesConfigurationSetInventory",
      "Effect": "Allow",
      "Action": "ses:ListConfigurationSets",
      "Resource": "*"
    },
    {
      "Sid": "ReadSesAccountAndIdentityStatus",
      "Effect": "Allow",
      "Action": [
        "ses:GetAccount",
        "ses:GetAccountSendingEnabled",
        "ses:GetSendQuota",
        "ses:GetSendStatistics",
        "ses:DescribeConfigurationSet",
        "ses:GetIdentityVerificationAttributes",
        "ses:GetIdentityDkimAttributes",
        "ses:GetIdentityMailFromDomainAttributes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateApiDestinationServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::620444453976:role/aws-service-role/apidestinations.events.amazonaws.com/AWSServiceRoleForAmazonEventBridgeApiDestinations",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "apidestinations.events.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageEventBridgeConnectionSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:UpdateSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:sa-east-1:620444453976:secret:events!connection/*"
    }
  ]
}
