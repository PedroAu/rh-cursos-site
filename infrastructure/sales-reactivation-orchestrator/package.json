{
  "name": "@rh-cursos/sales-reactivation-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism --maxWorkers=1",
    "smoke:load": "node --input-type=module -e \"const module = await import('./dist/handler.mjs'); if (typeof module.handler !== 'function') process.exit(1)\"",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke:load",
    "cli": "node ./dist/cli.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.984.0",
    "@aws-sdk/client-sesv2": "^3.984.0",
    "@supabase/supabase-js": "^2.106.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
}
